# ===== 环境变量示例 =====
# 复制为 .env 后填入真实值；或直接 export 到系统环境。
# ⚠️ .env 已加入 .gitignore，切勿把真实值提交到仓库。

# ---------- 钉钉群机器人 ----------
# 钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 Webhook
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_DINGTALK_ACCESS_TOKEN

# ---------- 定时任务 ----------
# 每日值班提醒时间（cron 表达式），默认每天 9:00
DAILY_CRON=0 9 * * *

# ---------- 时区 ----------
# 影响每日提醒的触发时间与排班日期判定，务必设为北京时间
TZ=Asia/Shanghai

# ---------- Web 编辑器 ----------
PORT=8080
BASE_PATH=/zb
# 编辑器登录密码
ZB_PASSWORD=change-me
# Hermes Web UI 反代（可选功能）
HERMES_PASSWORD=change-me-too
HERMES_TARGET=http://127.0.0.1:9119
HERMES_PATH=/hermes
# 登录 Cookie 签名密钥（改成一串长随机字符）
COOKIE_SECRET=change-this-cookie-secret

# ---------- 数据文件路径（可选，默认项目根目录） ----------
# DUTY_SCHEDULE_FILE=./duty_schedule.txt
# ADDRESS_FILE=./address.txt

# ---------- 调试 ----------
# 设为 1 时提醒只打印不真实发送，用于本地验证文案
# DUTY_DRYRUN=1
