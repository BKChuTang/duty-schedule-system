    "dryrun": "DUTY_DRYRUN=1 node workday.js"
  },
  "keywords": [
    "duty",
    "schedule",
    "roster",
    "calendar",
    "dingtalk",
    "reminder",
    "chinese-holidays",
    "值班",
    "排班"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.11",
    "lunar-javascript": "^1.7.8",
    "node-schedule": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
